# Copiar a .env.local y completar con valores reales
# .env.local está en .gitignore

# Neon PostgreSQL connection string
# Obtener desde: https://console.neon.tech → proyecto → Connection Details
NEON_DATABASE_URL=jdbc:postgresql://<host>.neon.tech:5432/<dbname>?sslmode=require

# URL base del GeoServer (no cambiar salvo que el geoportal migre)
WFS_BASE_URL=https://www.geoportal.cl/geoserver/ows
